        function fileToBase64(file) {
            return new Promise((resolve) => {
                if (!file) return resolve(null);
                const reader = new FileReader();
                reader.onload = () => resolve(reader.result);
                reader.onerror = () => resolve(null);
                reader.readAsDataURL(file);
            });
        }

        async function saveWorker(e) {
            e.preventDefault();
            const id = document.getElementById('workerId').value;
            const photoFile = document.getElementById('wPhotoInput').files[0];
            const idPhotoFile = document.getElementById('wIdPhotoInput').files[0];
            const cvFile = document.getElementById('wCvInput').files[0];

            let photoBase64 = photoFile ? await fileToBase64(photoFile) : null;
            let idPhotoBase64 = idPhotoFile ? await fileToBase64(idPhotoFile) : null;
            let cvBase64 = cvFile ? await fileToBase64(cvFile) : null;

            const bDate = new Date(document.getElementById('wBirthDate').value);
            const age = Math.abs(new Date(Date.now() - bDate.getTime()).getUTCFullYear() - 1970);

            let all = getStoredWorkers();
            const contractorInputVal = document.getElementById('wContractor').value.trim() || 'مباشر';

            let contractors = getStoredContractors();
            if (!contractors.includes(contractorInputVal)) {
                contractors.push(contractorInputVal);
                saveStoredContractors(contractors);
            }

            const workerData = {
                id: id ? Number(id) : Date.now(),
                project: currentProject,
                name: document.getElementById('wName').value.trim(),
                type: document.getElementById('wType').value,
                contractor: contractorInputVal,
                nationalId: document.getElementById('wNationalId').value.trim(),
                birthDate: document.getElementById('wBirthDate').value,
                age: age,
                job: document.getElementById('wJob').value.trim(),
                joinDate: document.getElementById('wJoinDate').value,
                ppe: {
                    helmet: document.getElementById('ppeHelmet').checked,
                    glasses: document.getElementById('ppeGlasses').checked,
                    ear: document.getElementById('ppeEar').checked,
                    vest: document.getElementById('ppeVest').checked,
                    gloves: document.getElementById('ppeGloves').checked,
                    shoes: document.getElementById('ppeShoes').checked,
                    mask: document.getElementById('ppeMask').checked
                },
                induction: document.getElementById('wInduction').value,
                weeklyLectures: document.getElementById('wWeeklyLectures').value.trim() || 'لا يوجد',
                dailyLectures: [],
                violationsList: [],
                commitment: Number(document.getElementById('wCommitment').value) || 100,
                injured: document.getElementById('wInjured').value,
                injuryPlace: document.getElementById('wInjuryPlace').value,
                medicalReport: document.getElementById('wMedicalReport').value.trim() || 'سليم طبياً',
                status: document.getElementById('wStatus').value,
                leaveReason: document.getElementById('wLeaveReason').value.trim() || 'مستمر على رأس العمل'
            };

            if (id) {
                const idx = all.findIndex(w => w.id === Number(id));
                if (idx !== -1) {
                    workerData.photo = photoBase64 || all[idx].photo;
                    workerData.idPhoto = idPhotoBase64 || all[idx].idPhoto;
                    workerData.cv = cvBase64 || all[idx].cv;
                    workerData.dailyLectures = all[idx].dailyLectures || [];
                    workerData.violationsList = all[idx].violationsList || [];
                    all[idx] = workerData;
                }
            } else {
                workerData.photo = photoBase64 || 'https://via.placeholder.com/60/111827/00f0ff?text=فرد';
                workerData.idPhoto = idPhotoBase64;
                workerData.cv = cvBase64;
                all.push(workerData);
            }

            saveStoredWorkers(all);
            closeWorkerModal();
            loadWorkers();
        }

