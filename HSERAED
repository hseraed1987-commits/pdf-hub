<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>منظومة إدارة السلامة والصحة المهنية المؤسسية - HSE AI Enterprise</title>
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800;900&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <style>
        body { font-family: 'Tajawal', sans-serif; background-color: #030712; color: #f3f4f6; overflow-x: hidden; }
        .glass-panel { background: rgba(17, 24, 39, 0.85); backdrop-filter: blur(12px); border: 1px solid rgba(56, 189, 248, 0.2); }
        .custom-scroll::-webkit-scrollbar { width: 5px; height: 5px; }
        .custom-scroll::-webkit-scrollbar-thumb { background: #0284c7; border-radius: 4px; }
        .custom-scroll::-webkit-scrollbar-track { background: #111827; }
        
        @media print {
            header, section, .no-print { display: none !important; }
            body { background: white !important; color: black !important; }
            .print-page { page-break-after: always; break-after: page; }
            img { max-width: 100% !important; print-color-adjust: exact; -webkit-print-color-adjust: exact; }
        }
    </style>
</head>
<body class="min-h-screen flex flex-col custom-scroll">

    <!-- شريط القيادة العلوي -->
    <header class="glass-panel sticky top-0 z-40 px-4 py-3 border-b border-cyan-500/30 no-print">
        <div class="max-w-[1700px] mx-auto flex flex-wrap items-center justify-between gap-3">
            
            <div class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-xl bg-slate-900 border border-cyan-500/50 flex items-center justify-center overflow-hidden cursor-pointer shadow-md" onclick="requestPinAndExecute(() => document.getElementById('companyLogoInput').click())" title="انقر لتغيير لوجو الشركة">
                    <img id="companyLogoDisplay" src="https://via.placeholder.com/80/111827/38bdf8?text=LOGO" alt="Logo" class="w-full h-full object-cover">
                    <input type="file" id="companyLogoInput" class="hidden" accept="image/*" onchange="uploadCompanyLogo(event)">
                </div>
                <div>
                    <h1 class="text-base md:text-lg font-black text-cyan-400">HSE ENTERPRISE SYSTEM</h1>
                    <p class="text-[11px] text-slate-400 font-semibold">منظومة الرقابة وإدارة السلامة والصحة المهنية المؤسسية الشاملة</p>
                </div>
            </div>

            <div class="flex items-center gap-2 bg-slate-950 px-3 py-1.5 rounded-xl border border-slate-700">
                <span class="text-xs text-slate-300 font-bold">المشروع:</span>
                <select id="currentProjectSelect" onchange="switchProject()" class="bg-transparent text-xs font-black text-cyan-300 focus:outline-none cursor-pointer pr-1 max-w-[170px] truncate">
                </select>
                <button onclick="requestPinAndExecute(openNewProjectModal)" class="text-[10px] bg-cyan-600/30 hover:bg-cyan-500 border border-cyan-500/50 text-cyan-200 px-2 py-1 rounded-lg font-bold transition">+ مشروع</button>
                <button onclick="requestPinAndExecute(openEditProjectModal)" class="text-[10px] bg-amber-600/30 hover:bg-amber-500 border border-amber-500/50 text-amber-200 px-2 py-1 rounded-lg font-bold transition">✏️ تعديل</button>
                <button onclick="requestPinAndExecute(deleteCurrentProject)" class="text-[10px] bg-rose-600/30 hover:bg-rose-500 border border-rose-500/50 text-rose-200 px-2 py-1 rounded-lg font-bold transition">🗑️ حذف</button>
            </div>

            <div class="flex items-center gap-3">
                <button onclick="requestPinAndExecute(openContractorsManagerModal)" class="bg-purple-500/20 hover:bg-purple-500/30 border border-purple-400 text-purple-300 text-xs font-bold px-3 py-1.5 rounded-xl transition" title="إدارة وإضافة وتعديل شركات المقاولات">
                    🏢 إدارة المقاولين
                </button>

                <button onclick="requestPinAndExecute(reloadDefaultSamples)" class="bg-cyan-500/20 hover:bg-cyan-500/30 border border-cyan-400 text-cyan-300 text-xs font-bold px-3 py-1.5 rounded-xl transition" title="إعادة شحن النماذج التوضيحية">
                    🔄 النماذج الجاهزة
                </button>

                <div class="text-left font-mono hidden xl:block bg-slate-900 px-3 py-1 rounded-xl border border-slate-800">
                    <div id="liveClock" class="text-xs font-black text-cyan-400">00:00:00</div>
                    <div id="liveDate" class="text-[10px] text-slate-400">--/--/----</div>
                </div>

                <button onclick="openFounderModal()" class="bg-amber-500/20 hover:bg-amber-500/30 border border-amber-400 text-amber-300 px-3 py-1.5 rounded-xl flex items-center gap-1.5 transition text-xs font-black">
                    <span>🔒 إعدادات المؤسس</span>
                </button>
            </div>

        </div>
    </header>

    <!-- شريط المؤسس الثابت -->
    <section class="max-w-[1700px] w-full mx-auto px-4 pt-3 no-print">
        <div class="glass-panel p-3.5 rounded-2xl flex flex-wrap items-center justify-between gap-3 border border-amber-500/30 bg-gradient-to-r from-amber-500/10 via-slate-900 to-cyan-500/10">
            <div class="flex items-center gap-3.5">
                <div class="w-13 h-13 rounded-2xl overflow-hidden border-2 border-amber-400 shadow-md cursor-pointer" onclick="openFounderModal()">
                    <img id="mainFounderPhoto" src="https://via.placeholder.com/100/111827/f59e0b?text=المؤسس" class="w-full h-full object-cover">
                </div>
                <div>
                    <h3 id="mainFounderName" class="text-sm font-black text-amber-400">رائد الغريزي</h3>
                    <p id="mainFounderBio" class="text-xs text-slate-300 mt-0.5 font-medium">
                        مدير سلامة وصحة مهنية | باحث ماجستير سلامة وصحة مهنية | عضو رابطة المدربين الدوليين العرب | أخصائي سلامة وصحة مهنية
                    </p>
                </div>
            </div>
            <div class="text-[11px] text-slate-300 bg-black/60 px-3 py-1.5 rounded-xl border border-amber-500/30 flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
                <span>الاعتماد الإداري محمي وموثق برقم الأمان: <b>2761987</b></span>
            </div>
        </div>
    </section>

    <!-- المحتوى والعدادات الميدانية -->
    <main class="max-w-[1700px] w-full mx-auto p-4 flex-1 space-y-4">

        <div class="grid grid-cols-2 md:grid-cols-6 gap-3.5 no-print">
            <div class="glass-panel p-3.5 rounded-2xl border-r-4 border-cyan-400">
                <p class="text-[11px] text-slate-400 font-bold uppercase">إجمالي أفراد المشروع</p>
                <h3 id="statTotal" class="text-2xl font-black mt-1 text-white font-mono">0</h3>
                <span class="text-[10px] text-cyan-300 font-semibold" id="statProjectBadge">مشروع مستقل</span>
            </div>
            <div class="glass-panel p-3.5 rounded-2xl border-r-4 border-amber-400">
                <p class="text-[11px] text-slate-400 font-bold uppercase">عمالة المقاولين</p>
                <h3 id="statContractor" class="text-2xl font-black mt-1 text-amber-400 font-mono">0</h3>
                <span class="text-[10px] text-amber-400/80 font-semibold">مقاولين باطن</span>
            </div>
            <div class="glass-panel p-3.5 rounded-2xl border-r-4 border-sky-400">
                <p class="text-[11px] text-slate-400 font-bold uppercase">عمالة ذاتية</p>
                <h3 id="statDirect" class="text-2xl font-black mt-1 text-sky-400 font-mono">0</h3>
                <span class="text-[10px] text-sky-400/80 font-semibold">تعيين مباشر</span>
            </div>
            <div class="glass-panel p-3.5 rounded-2xl border-r-4 border-purple-400">
                <p class="text-[11px] text-slate-400 font-bold uppercase">موظفون ومهندسون</p>
                <h3 id="statStaff" class="text-2xl font-black mt-1 text-purple-400 font-mono">0</h3>
                <span class="text-[10px] text-purple-400/80 font-semibold">الجهاز الفني والإداري</span>
            </div>
            <div class="glass-panel p-3.5 rounded-2xl border-r-4 border-emerald-400">
                <p class="text-[11px] text-slate-400 font-bold uppercase">أمن وحراسة إدارية</p>
                <h3 id="statSecurity" class="text-2xl font-black mt-1 text-emerald-400 font-mono">0</h3>
                <span class="text-[10px] text-emerald-400/80 font-semibold">تأمين الميدان والبوابات</span>
            </div>
            <div class="glass-panel p-3.5 rounded-2xl border-r-4 border-teal-400">
                <p class="text-[11px] text-slate-400 font-bold uppercase">فريق السيفتي</p>
                <h3 id="statSafety" class="text-2xl font-black mt-1 text-teal-400 font-mono">0</h3>
                <span class="text-[10px] text-teal-400/80 font-semibold">أخصائيو ومهندسو HSE</span>
            </div>
        </div>

        <div class="glass-panel p-2.5 rounded-2xl flex flex-wrap items-center justify-between gap-3 no-print">
            <div class="flex flex-wrap items-center gap-2">
                <button onclick="setActiveTab('عمالة مقاول')" id="tab-contractor" class="px-3 py-2 rounded-xl text-xs font-black transition flex items-center gap-1.5 bg-amber-500/20 text-amber-300 border border-amber-400">
                    <span class="w-2.5 h-2.5 rounded-full bg-amber-400"></span>
                    <span>عمالة مقاول</span>
                    <span id="badge-contractor" class="bg-amber-950 text-amber-300 px-1.5 py-0.2 rounded-full text-[10px] font-mono">0</span>
                </button>
                <button onclick="setActiveTab('عمالة ذاتية')" id="tab-direct" class="px-3 py-2 rounded-xl text-xs font-black transition flex items-center gap-1.5 bg-slate-900 text-slate-400 hover:text-cyan-300 border border-slate-800">
                    <span class="w-2.5 h-2.5 rounded-full bg-cyan-400"></span>
                    <span>عمالة ذاتية</span>
                    <span id="badge-direct" class="bg-slate-800 text-slate-300 px-1.5 py-0.2 rounded-full text-[10px] font-mono">0</span>
                </button>
                <button onclick="setActiveTab('موظفين')" id="tab-staff" class="px-3 py-2 rounded-xl text-xs font-black transition flex items-center gap-1.5 bg-slate-900 text-slate-400 hover:text-purple-300 border border-slate-800">
                    <span class="w-2.5 h-2.5 rounded-full bg-purple-400"></span>
                    <span>موظفين</span>
                    <span id="badge-staff" class="bg-slate-800 text-slate-300 px-1.5 py-0.2 rounded-full text-[10px] font-mono">0</span>
                </button>
                <button onclick="setActiveTab('أمن إداري')" id="tab-security" class="px-3 py-2 rounded-xl text-xs font-black transition flex items-center gap-1.5 bg-slate-900 text-slate-400 hover:text-emerald-300 border border-slate-800">
                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-400"></span>
                    <span>أمن إداري</span>
                    <span id="badge-security" class="bg-slate-800 text-slate-300 px-1.5 py-0.2 rounded-full text-[10px] font-mono">0</span>
                </button>
                <button onclick="setActiveTab('فريق السيفتي')" id="tab-safety" class="px-3 py-2 rounded-xl text-xs font-black transition flex items-center gap-1.5 bg-slate-900 text-slate-400 hover:text-teal-300 border border-slate-800">
                    <span class="w-2.5 h-2.5 rounded-full bg-teal-400"></span>
                    <span>فريق السيفتي</span>
                    <span id="badge-safety" class="bg-slate-800 text-slate-300 px-1.5 py-0.2 rounded-full text-[10px] font-mono">0</span>
                </button>
            </div>

            <button onclick="requestPinAndExecute(openWorkerModal)" class="bg-cyan-600 hover:bg-cyan-500 text-white text-xs font-black px-4 py-2 rounded-xl transition flex items-center gap-2 shadow-lg">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                <span>تسجيل فرد جديد في هذا القسم</span>
            </button>
        </div>

        <div class="glass-panel p-3.5 rounded-2xl flex flex-wrap items-center justify-between gap-3 no-print">
            <div class="flex flex-1 min-w-[260px] items-center bg-slate-950 border border-slate-700 px-3 py-1.5 rounded-xl">
                <svg class="w-4 h-4 text-cyan-400 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                <input type="text" id="searchInput" oninput="renderCurrentView()" placeholder="بحث ذكي بالاسم، الرقم القومي، المهنة، المقاول..." class="w-full bg-transparent text-xs text-white focus:outline-none">
            </div>

            <div class="flex flex-wrap items-center gap-2">
                <div class="flex items-center gap-1.5 bg-slate-950 border border-cyan-500/40 px-2.5 py-1 rounded-xl">
                    <span class="text-xs text-cyan-300 font-bold">نطاق التقرير والطباعة:</span>
                    <select id="exportScopeSelect" onchange="toggleExportFilterUI()" class="bg-transparent text-xs font-black text-white focus:outline-none cursor-pointer">
                        <option value="ALL" class="bg-slate-900 text-cyan-400">تقرير مجمع لجميع الأقسام</option>
                        <option value="CURRENT_TAB" class="bg-slate-900 text-amber-400">القسم الحالي فقط (مجمع)</option>
                        <option value="SPECIFIC_CONTRACTOR" class="bg-slate-900 text-purple-400">لمقاول محدد بذاته</option>
                        <option value="SPECIFIC_WORKER" class="bg-slate-900 text-emerald-400">لعامل/موظف محدد بالاسم</option>
                    </select>
                </div>

                <div id="contractorFilterBox" class="hidden flex items-center gap-1.5 bg-slate-950 border border-amber-500/50 px-2.5 py-1 rounded-xl">
                    <span class="text-xs text-amber-300 font-bold">اختر المقاول:</span>
                    <select id="contractorFilterSelect" class="bg-transparent text-xs font-black text-white focus:outline-none cursor-pointer">
                    </select>
                </div>

                <div id="workerFilterBox" class="hidden flex items-center gap-1.5 bg-slate-950 border border-emerald-500/50 px-2.5 py-1 rounded-xl">
                    <span class="text-xs text-emerald-300 font-bold">اختر الفرد:</span>
                    <select id="workerFilterSelect" class="bg-transparent text-xs font-black text-white focus:outline-none cursor-pointer">
                    </select>
                </div>

                <button onclick="executeExport('excel')" class="bg-emerald-700/40 hover:bg-emerald-600 border border-emerald-400 text-emerald-300 text-xs font-bold px-3 py-1.5 rounded-xl transition flex items-center gap-1">
                    <span>📊 Excel</span>
                </button>
                <button onclick="executeExport('word')" class="bg-blue-700/40 hover:bg-blue-600 border border-blue-400 text-blue-300 text-xs font-bold px-3 py-1.5 rounded-xl transition flex items-center gap-1">
                    <span>📝 Word</span>
                </button>
                <button onclick="executeExport('pdf')" class="bg-rose-700/40 hover:bg-rose-600 border border-rose-400 text-rose-300 text-xs font-bold px-3 py-1.5 rounded-xl transition flex items-center gap-1">
                    <span>📑 طباعة PDF معتمدة</span>
                </button>
                <button onclick="executeExport('qr_only')" class="bg-cyan-700/40 hover:bg-cyan-600 border border-cyan-400 text-cyan-300 text-xs font-bold px-3 py-1.5 rounded-xl transition flex items-center gap-1">
                    <span>📱 طباعة QR فقط</span>
                </button>
            </div>
        </div>

        <div class="glass-panel rounded-2xl overflow-hidden border border-slate-700 shadow-2xl no-print">
            <div class="overflow-x-auto custom-scroll">
                <table class="w-full text-right text-xs">
                    <thead class="bg-slate-950 text-cyan-300 font-black border-b border-slate-700">
                        <tr>
                            <th class="p-3">الفرد والهوية</th>
                            <th class="p-3">التبعية والمهنة</th>
                            <th class="p-3">السن والأهلية</th>
                            <th class="p-3">مهمات الوقاية (PPE)</th>
                            <th class="p-3">المحاضرات / الدورات</th>
                            <th class="p-3 bg-rose-950/30 border-x border-rose-500/20 text-rose-300">سجل المخالفات والجزاءات</th>
                            <th class="p-3">السجل الطبي والإصابة</th>
                            <th class="p-3">حالة العمل وترك الخدمة</th>
                            <th class="p-3 text-center">QR كود حقيقي</th>
                            <th class="p-3 text-center">إجراءات</th>
                        </tr>
                    </thead>
                    <tbody id="workersTableBody" class="divide-y divide-slate-800 text-slate-200">
                    </tbody>
                </table>
            </div>
            <div id="noDataAlert" class="hidden p-8 text-center text-slate-400 font-bold">
                لا توجد بيانات مسجلة في هذا النطاق التابع لمشروع (<span id="emptyProjectLabel" class="text-cyan-400"></span>).
            </div>
        </div>

        <div id="printableReportArea" class="hidden bg-white text-black p-4"></div>

    </main>

    <!-- نافذة طلب الرقم السري العامة للعمليات -->
    <div id="globalPinModal" class="fixed inset-0 bg-black/85 backdrop-blur-md z-50 hidden flex items-center justify-center p-4 no-print">
        <div class="glass-panel border border-amber-500/60 rounded-2xl max-w-sm w-full p-5 shadow-2xl relative text-center">
            <button onclick="closeGlobalPinModal()" class="absolute top-3 left-3 text-slate-400 hover:text-white text-xl font-bold">&times;</button>
            <div class="w-10 h-10 rounded-xl bg-amber-500/20 border border-amber-400 text-amber-400 flex items-center justify-center font-bold text-lg mx-auto mb-2">🔒</div>
            <h3 class="text-sm font-black text-white mb-1">تأكيد صلاحية المسؤول</h3>
            <p class="text-[11px] text-slate-300 mb-3">يرجى إدخال رقم الأمان السري للمتابعة وإتمام التعديل:</p>
            <input type="password" id="globalPinInput" placeholder="أدخل رمز الأمان..." class="w-full bg-slate-900 border border-slate-700 rounded-lg p-2 text-xs text-white mb-2 text-center">
            <p id="globalPinError" class="text-xs text-rose-500 hidden font-bold mb-2">رقم الأمان غير صحيح!</p>
            <div class="flex gap-2">
                <button onclick="closeGlobalPinModal()" class="flex-1 py-2 rounded-xl bg-slate-800 text-xs font-bold">إلغاء</button>
                <button onclick="verifyGlobalPin()" class="flex-1 py-2 rounded-xl bg-amber-600 hover:bg-amber-500 text-white text-xs font-black">تحقق وتنفيذ</button>
            </div>
        </div>
    </div>

    <!-- نافذة إدارة المقاولين -->
    <div id="contractorsManagerModal" class="fixed inset-0 bg-black/85 backdrop-blur-md z-50 hidden flex items-center justify-center p-4 no-print">
        <div class="glass-panel border border-purple-500/60 rounded-2xl max-w-lg w-full p-5 shadow-2xl relative text-xs">
            <button onclick="closeContractorsManagerModal()" class="absolute top-3 left-3 text-slate-400 hover:text-white text-xl font-bold">&times;</button>
            <div class="flex items-center gap-2 mb-3 border-b border-slate-700 pb-2">
                <span class="text-base">🏢</span>
                <div>
                    <h3 class="text-sm font-black text-purple-300">إدارة شركات المقاولات (إضافة، تعديل، حذف)</h3>
                    <p class="text-[11px] text-slate-400">أضف شركات المقاولات الحقيقية العاملة معك في الموقع.</p>
                </div>
            </div>

            <div class="bg-slate-950 p-3 rounded-xl border border-slate-800 space-y-2 mb-3">
                <label class="block text-slate-300 font-bold">اسم شركة المقاولات الجديدة:</label>
                <div class="flex gap-2">
                    <input type="text" id="newContractorNameInput" placeholder="اكتب اسم الشركة الحقيقي..." class="flex-1 bg-slate-900 border border-slate-700 rounded-lg p-2 text-white text-xs">
                    <button onclick="addNewContractor()" class="bg-purple-600 hover:bg-purple-500 text-white font-black px-4 py-2 rounded-lg transition">+ إضافة</button>
                </div>
            </div>

            <div>
                <h4 class="font-bold text-slate-300 mb-1">الشركات المسجلة حالياً:</h4>
                <div id="contractorsListContainer" class="max-h-44 overflow-y-auto custom-scroll space-y-1.5 bg-slate-950 p-2 rounded-xl border border-slate-800"></div>
            </div>
        </div>
    </div>

    <!-- نافذة العامل -->
    <div id="workerModal" class="fixed inset-0 bg-black/85 backdrop-blur-md z-50 hidden flex items-center justify-center p-3 overflow-y-auto no-print">
        <div class="glass-panel border border-cyan-500/50 w-full max-w-4xl shadow-2xl rounded-2xl overflow-hidden my-4">
            <div class="p-4 bg-slate-900 border-b border-slate-700 flex justify-between items-center">
                <h3 id="modalTitle" class="text-sm font-black text-cyan-400">استمارة قيد وتحديث بيانات الفرد الميدانية</h3>
                <button onclick="closeWorkerModal()" class="text-slate-400 hover:text-white text-2xl font-bold">&times;</button>
            </div>
            
            <form id="workerForm" onsubmit="saveWorker(event)" class="p-5 space-y-5 max-h-[80vh] overflow-y-auto custom-scroll text-xs">
                <input type="hidden" id="workerId">

                <div class="space-y-2">
                    <div class="flex justify-between items-center border-b border-slate-700 pb-1">
                        <h4 class="font-black text-cyan-300">1. البيانات الشخصية والهوية والتصنيف</h4>
                        <span class="text-[10px] text-emerald-400 font-mono">Real-Time QR Ready ✓</span>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
                        <div>
                            <label class="block text-slate-300 font-semibold mb-1">الاسم الكامل *</label>
                            <input type="text" id="wName" required oninput="triggerLiveQRPreview()" placeholder="اكتب اسم الفرد..." class="w-full bg-slate-900 border border-slate-700 rounded-lg p-2 text-white">
                        </div>
                        <div>
