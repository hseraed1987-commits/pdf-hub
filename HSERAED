        let projectsList = JSON.parse(localStorage.getItem('hse_projects_list')) || ['مشروع الأنفاق ومحطات المترو المركزية', 'مشروع إنشاء الأبراج السكنية'];
        let activeTab = 'عمالة مقاول';
        let currentTbtWorkerId = null;
        let currentViolationWorkerId = null;
        let cachedWorkers = [];
        let pendingAction = null;

        let contractorsList = JSON.parse(localStorage.getItem('hse_contractors_master_list')) || [
            "شركة الأمانة للمقاولات والتجارة",
            "شركة الإتقان للإنشاءات الهندسية",
            "مؤسسة النور للمقاولات والبناء"
        ];

        function requestPinAndExecute(actionCallback) {
            pendingAction = actionCallback;
            document.getElementById('globalPinInput').value = '';
            document.getElementById('globalPinError').classList.add('hidden');
            document.getElementById('globalPinModal').classList.remove('hidden');
        }

        function closeGlobalPinModal() {
            document.getElementById('globalPinModal').classList.add('hidden');
            pendingAction = null;
        }

        function verifyGlobalPin() {
            const enteredPin = document.getElementById('globalPinInput').value;
            if (enteredPin === FOUNDER_PIN) {
                document.getElementById('globalPinModal').classList.add('hidden');
                if (typeof pendingAction === 'function') {
                    pendingAction();
                }
                pendingAction = null;
            } else {
                document.getElementById('globalPinError').classList.remove('hidden');
            }
        }

        function getStoredContractors() {
            let list = localStorage.getItem('hse_contractors_master_list');
            if (!list) {
                localStorage.setItem('hse_contractors_master_list', JSON.stringify(contractorsList));
                return contractorsList;
            }
            return JSON.parse(list);
        }

        function saveStoredContractors(list) {
            contractorsList = list;
            localStorage.setItem('hse_contractors_master_list', JSON.stringify(list));
        }

        function openContractorsManagerModal() {
            renderContractorsManagerList();
            document.getElementById('contractorsManagerModal').classList.remove('hidden');
        }

        function closeContractorsManagerModal() {
            document.getElementById('contractorsManagerModal').classList.add('hidden');
        }

        function renderContractorsManagerList() {
            const container = document.getElementById('contractorsListContainer');
            container.innerHTML = '';
            const list = getStoredContractors();
            if (list.length === 0) {
                container.innerHTML = '<p class="text-slate-400 text-center py-2">لا توجد شركات مقاولات مسجلة.</p>';
                return;
            }
            list.forEach((c, idx) => {
                const div = document.createElement('div');
                div.className = "flex justify-between items-center bg-slate-900 p-2 rounded-lg border border-slate-800";
                div.innerHTML = `
                    <span class="font-bold text-white">${idx + 1}. ${c}</span>
                    <div class="flex items-center gap-1">
                        <button onclick="requestPinAndExecute(() => editContractorName(${idx}))" class="text-cyan-400 hover:text-cyan-300 px-2 py-1 text-xs font-bold bg-cyan-500/10 rounded">✏️ تعديل</button>
                        <button onclick="requestPinAndExecute(() => deleteContractorName(${idx}))" class="text-rose-400 hover:text-rose-300 px-2 py-1 text-xs font-bold bg-rose-500/10 rounded">🗑️ حذف</button>
                    </div>
                `;
                container.appendChild(div);
            });
        }

        function addNewContractor() {
            const input = document.getElementById('newContractorNameInput');
            const name = input.value.trim();
            if (!name) {
                alert("يرجى كتابة اسم شركة المقاولات.");
                return;
            }
            let list = getStoredContractors();
            if (list.includes(name)) {
                alert("هذه الشركة مسجلة مسبقاً!");
                return;
            }
            list.push(name);
            saveStoredContractors(list);
            input.value = '';
            renderContractorsManagerList();
            populateExportDropdowns();
        }

        function editContractorName(idx) {
            let list = getStoredContractors();
            const oldName = list[idx];
            const newName = prompt("تعديل اسم شركة المقاولات:", oldName);
            if (newName && newName.trim() !== "" && newName.trim() !== oldName) {
                list[idx] = newName.trim();
                saveStoredContractors(list);
                renderContractorsManagerList();
                populateExportDropdowns();
            }
        }

        function deleteContractorName(idx) {
            let list = getStoredContractors();
            if (list.length <= 1) {
                alert("يجب أن تبقي على شركة مقاولات واحدة على الأقل!");
                return;
            }
            if (confirm(`هل أنت متأكد من حذف شركة (${list[idx]})؟`)) {
                list.splice(idx, 1);
                saveStoredContractors(list);
                renderContractorsManagerList();
                populateExportDropdowns();
            }
        }

        const defaultSampleWorkers = [
            {
