        function getDatasetForExport() {
            const scope = document.getElementById('exportScopeSelect').value;
            if (scope === 'ALL') {
                return {
                    list: cachedWorkers,
                    title: `تقرير مجمع شامل لجميع أقسام المشروع (${currentProject})`
                };
            } else if (scope === 'CURRENT_TAB') {
                return {
                    list: cachedWorkers.filter(w => w.type === activeTab),
                    title: `تقرير تفصيلي - قسم (${activeTab}) - مشروع (${currentProject})`
                };
            } else if (scope === 'SPECIFIC_CONTRACTOR') {
                const selectedContractor = document.getElementById('contractorFilterSelect').value;
                return {
                    list: cachedWorkers.filter(w => w.contractor === selectedContractor),
                    title: `تقرير سلامة مخصص لمقاول: (${selectedContractor}) - مشروع (${currentProject})`
                };
            } else if (scope === 'SPECIFIC_WORKER') {
                const selectedWorkerId = Number(document.getElementById('workerFilterSelect').value);
                const workerObj = cachedWorkers.find(w => w.id === selectedWorkerId);
                return {
                    list: workerObj ? [workerObj] : [],
                    title: workerObj ? `صحيفة اعتماد فردية للعامل: (${workerObj.name}) - مشروع (${currentProject})` : `صحيفة فردية`
                };
            }
        }

        function executeExport(type) {
            const dataObj = getDatasetForExport();
            if (!dataObj || dataObj.list.length === 0) {
                alert(`لا توجد بيانات متاحة للتصدير في هذا النطاق.`); return;
            }

            if (type === 'excel') exportExcelFile(dataObj);
            else if (type === 'word') exportWordFile(dataObj);
            else if (type === 'pdf') printOfficialDossierPDF(dataObj);
            else if (type === 'qr_only') printQROnlyBatch(dataObj);
        }

