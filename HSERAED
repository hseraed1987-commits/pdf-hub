            container.innerHTML = pagesHtml;
            container.classList.remove('hidden');
            window.print();
            setTimeout(() => {
                container.classList.add('hidden');
                container.innerHTML = '';
            }, 1000);
        }

        async function printQROnlyBatch({ list, title }) {
            const container = document.getElementById('printableReportArea');
            let qrGridHtml = `
                <div style="padding: 20px; font-family: Arial, sans-serif;">
                    <h2 style="text-align: center; margin-bottom: 20px; color: #0f172a;">${title} - جوازات الـ QR الميدانية</h2>
                    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 15px;">
            `;

            for (const w of list) {
                const qrBase64 = await getBase64QRImage(buildWorkerQRPayload(w), 130);
                qrGridHtml += `
                    <div style="border: 2px solid #334155; border-radius: 10px; padding: 12px; text-align: center; background: #fff; page-break-inside: avoid;">
                        <h4 style="font-size: 13px; font-weight: bold; margin-bottom: 4px; color: #0284c7;">${w.name}</h4>
                        <p style="font-size: 10px; color: #475569; margin-bottom: 6px;"><b>المهنة:</b> ${w.job} | <b>المقاول:</b> ${w.contractor}</p>
                        <div style="margin: 5px auto;"><img src="${qrBase64}" style="width: 130px; height: 130px; display: block; margin: 0 auto;" crossorigin="anonymous"></div>
                        <p style="font-size: 9px; color: #059669; font-weight: bold; margin-top: 4px;">مسح للتحقق الميداني الفوري</p>
                    </div>
                `;
            }

            qrGridHtml += `</div></div>`;
            container.innerHTML = qrGridHtml;
            container.classList.remove('hidden');
            window.print();
            setTimeout(() => {
                container.classList.add('hidden');
                container.innerHTML = '';
            }, 1000);
        }

        function openWorkerModal() {
            document.getElementById('workerForm').reset();
            document.getElementById('workerId').value = '';
            document.getElementById('wType').value = activeTab;
            toggleStaffSafetyFields();
            populateExportDropdowns();
            document.getElementById('modalTitle').innerText = `تسجيل جديد في: (${activeTab})`;
            document.getElementById('ageStatusBox').classList.add('hidden');
            document.getElementById('workerModal').classList.remove('hidden');
        }

        function closeWorkerModal() { document.getElementById('workerModal').classList.add('hidden'); }

        function editWorker(id) {
            const w = cachedWorkers.find(item => item.id === id);
            if (!w) return;
            populateExportDropdowns();
            document.getElementById('workerId').value = w.id;
            document.getElementById('wName').value = w.name;
            document.getElementById('wType').value = w.type;
            toggleStaffSafetyFields();
            document.getElementById('wContractor').value = w.contractor;
            document.getElementById('wNationalId').value = w.nationalId;
            document.getElementById('wBirthDate').value = w.birthDate;
            document.getElementById('wJob').value = w.job;
            document.getElementById('wJoinDate').value = w.joinDate;
            document.getElementById('wInduction').value = w.induction;
            document.getElementById('wWeeklyLectures').value = w.weeklyLectures;
            document.getElementById('wCommitment').value = w.commitment;
            document.getElementById('wInjured').value = w.injured;
            document.getElementById('wInjuryPlace').value = w.injuryPlace;
            document.getElementById('wMedicalReport').value = w.medicalReport;
            document.getElementById('wStatus').value = w.status;
            document.getElementById('wLeaveReason').value = w.leaveReason;
            checkAgeEligibility();
            triggerLiveQRPreview();
            document.getElementById('modalTitle').innerText = "تعديل بيانات: " + w.name;
            document.getElementById('workerModal').classList.remove('hidden');
        }

        function deleteWorker(id) {
            if (confirm("هل أنت متأكد من حذف هذا السجل نهائياً؟")) {
                let all = getStoredWorkers().filter(w => w.id !== id);
                saveStoredWorkers(all);
                loadWorkers();
            }
        }

        function reloadDefaultSamples() {
            if (confirm("هل تريد استعادة وشحن النماذج الأصلية؟")) {
                localStorage.setItem('hse_workers_master_data', JSON.stringify(defaultSampleWorkers));
                loadWorkers();
                alert("تم التحميل بنجاح!");
            }
        }

        function openFounderModal() {
            document.getElementById('founderModal').classList.remove('hidden');
            document.getElementById('founderLockSection').classList.remove('hidden');
            document.getElementById('founderEditSection').classList.add('hidden');
            document.getElementById('founderPinInput').value = '';
            document.getElementById('pinErrorMsg').classList.add('hidden');
        }

        function closeFounderModal() { document.getElementById('founderModal').classList.add('hidden'); }

        function unlockFounderEdit() {
            const pin = document.getElementById('founderPinInput').value;
            if (pin === FOUNDER_PIN) {
                document.getElementById('founderLockSection').classList.add('hidden');
                document.getElementById('founderEditSection').classList.remove('hidden');
                document.getElementById('founderNameInput').value = localStorage.getItem('founder_name') || "رائد الغريزي";
                document.getElementById('founderBioInput').value = localStorage.getItem('founder_bio') || "مدير سلامة وصحة مهنية | باحث ماجستير سلامة وصحة مهنية | عضو رابطة المدربين الدوليين العرب | أخصائي سلامة وصحة مهنية";
            } else {
                document.getElementById('pinErrorMsg').classList.add('hidden');
            }
        }

        async function saveFounderData() {
            const name = document.getElementById('founderNameInput').value.trim();
            const bio = document.getElementById('founderBioInput').value.trim();
            const photoFile = document.getElementById('founderPhotoInput').files[0];

            if (name) localStorage.setItem('founder_name', name);
            if (bio) localStorage.setItem('founder_bio', bio);
            if (photoFile) {
                const b64 = await fileToBase64(photoFile);
                localStorage.setItem('founder_photo', b64);
            }

            loadFounderData();
            alert("تم حفظ وتحديث بيانات وصورة المؤسس بنجاح.");
            closeFounderModal();
        }

        function loadFounderData() {
            const name = localStorage.getItem('founder_name') || "رائد الغريزي";
            const bio = localStorage.getItem('founder_bio') || "مدير سلامة وصحة مهنية | باحث ماجستير سلامة وصحة مهنية | عضو رابطة المدربين الدوليين العرب | أخصائي سلامة وصحة مهنية";
            const photo = localStorage.getItem('founder_photo');

            document.getElementById('mainFounderName').innerText = name;
            document.getElementById('mainFounderBio').innerText = bio;
            if (photo) document.getElementById('mainFounderPhoto').src = photo;
        }

        async function uploadCompanyLogo(event) {
            const file = event.target.files[0];
            if (file) {
                const b64 = await fileToBase64(file);
                localStorage.setItem('company_logo_data', b64);
                loadCompanyLogo();
            }
        }

        function loadCompanyLogo() {
            const logo = localStorage.getItem('company_logo_data');
            if (logo) document.getElementById('companyLogoDisplay').src = logo;
        }

        window.onload = function() {
            initLiveClock();
            loadProjectsUI();
            loadFounderData();
            loadCompanyLogo();
            loadWorkers();
        };
    </script>
</body>
</html>
