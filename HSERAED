                    { date: "2026-09-15", topic: "مخاطر رفع الحديد والأخشاب يدوياً وطرق الوقاية من آلام الظهر" }
                ],
                violationsList: [
                    { date: "2026-09-02", type: "عدم ارتداء مهمات الوقاية (PPE)", count: "المرة الأولى", action: "إنذار كتابي أول وتوجيه", penalty: "تسجيل إنذار رسمي بملف المقاول وخصم يوم من الحافز" }
                ],
                commitment: 90,
                injured: "لا",
                injuryPlace: "لم يصب",
                medicalReport: "سليم طبياً ولائق بدنياً للعمل الميداني",
                status: "مستمر بالعمل",
                leaveReason: "مستمر بموجب العقد الحالي ولا يوجد إخلاء طرف",
                photo: "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=120&h=120&fit=crop&crop=face"
            }
