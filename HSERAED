            const count = document.getElementById('newVCount').value;
            const action = document.getElementById('newVAction').value;
            const penalty = document.getElementById('newVPenalty').value.trim() || 'إنذار وتوجيه شفهي';

            let all = getStoredWorkers();
            const idx = all.findIndex(w => w.id === currentViolationWorkerId);
            if (idx !== -1) {
                if (!all[idx].violationsList) all[idx].violationsList = [];
                all[idx].violationsList.push({ date, type, count, action, penalty });
                all[idx].commitment = Math.max(0, (all[idx].commitment || 100) - 10);
                if (action.includes('استبعاد')) {
                    all[idx].status = "تم الاستبعاد (مخالفات صريحة)";
                    all[idx].leaveReason = `استبعاد تأديبي: ${type} - الجزاء: ${penalty}`;
