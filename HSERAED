            list.forEach(w => {
                const tr = document.createElement('tr');
                tr.className = "hover:bg-cyan-500/5 transition border-b border-slate-800/80";

                const isUnderage = w.age < 18;
                const ppeList = [];
                if (w.ppe.helmet) ppeList.push('خوذة');
                if (w.ppe.glasses) ppeList.push('نظارة');
                if (w.ppe.ear) ppeList.push('سدادة');
